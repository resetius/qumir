#!/bin/sh
set -e

# The data directory itself is left to the administrator; only the account the
# service runs under is created here.
if [ "$1" = "configure" ]; then
    if ! getent passwd qumir >/dev/null; then
        adduser --system --group --no-create-home \
                --home /var/lib/qumir-data \
                --gecos "Qumir playground service" \
                qumir
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
