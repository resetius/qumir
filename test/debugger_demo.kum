алг цел main
нач
    лит label
    цел result
    label := "LLDB sample"
    result := run_case(label, 1071, 462)
    вывод "Result: ", result, нс
    знач := 0
кон

алг цел run_case(лит label, цел a, цел b)
нач
    цел common, sequence, result
    вещ ratio
    лог correct
    сим marker

    common := gcd(a, b)
    sequence := fibonacci(6)
    ratio := a / common
    correct := common = 21
    marker := 'A'
    increment(common)
    inspect_values(label, common, ratio, correct, marker)
    result := common + sequence
    знач := result
кон

алг цел gcd(цел a, цел b)
нач
    цел remainder
    если b = 0 то
        знач := a
    иначе
        remainder := mod(a, b)
        знач := gcd(b, remainder)
    все
кон

алг цел fibonacci(цел n)
нач
    цел left, right
    если n <= 1 то
        знач := n
    иначе
        left := fibonacci(n - 1)
        right := fibonacci(n - 2)
        знач := left + right
    все
кон

алг increment(аргрез цел value)
нач
    цел before
    before := value
    value := before + 1
кон

алг inspect_values(лит label, цел count, вещ ratio, лог enabled, сим marker)
нач
    лит message
    цел next
    вещ scaled
    лог positive
    сим letter

    message := label + " locals"
    next := count + 1
    scaled := ratio * 1.5
    positive := enabled и (scaled > 0.0)
    letter := marker
    вывод message, ": ", next, " ", scaled, " ", positive, " ", letter, нс
кон
