function <main> () { ; void
  block {
    label: label(0)
    arg imm(1,i1) 
    call tmp(0,i1) = choose 
    cmp tmp(0,i1) label(2) label(3) 
  }
  block {
    label: label(2)
    arg imm(1,ptr to i8) 
    call output_string 
    jmp label(4) 
  }
  block {
    label: label(3)
    arg imm(2,ptr to i8) 
    call output_string 
    jmp label(4) 
  }
  block {
    label: label(4)
    arg imm(3,ptr to i8) 
    call output_string 
    arg imm(0,i1) 
    call tmp(1,i1) = choose 
    cmp tmp(1,i1) label(5) label(6) 
  }
  block {
    label: label(5)
    arg imm(2,ptr to i8) 
    call output_string 
    jmp label(7) 
  }
  block {
    label: label(6)
    arg imm(1,ptr to i8) 
    call output_string 
    jmp label(7) 
  }
  block {
    label: label(7)
    arg imm(4,ptr to i8) 
    call output_string 
    jmp label(1) 
  }
  block {
    label: label(1)
    ret 
  }
}
function choose (local(0)) { ; i1
  block {
    label: label(0)
    load tmp(0,i1) = local(0,i1) 
    cmp tmp(0,i1) label(2) label(3) 
  }
  block {
    label: label(2)
    jmp label(4) 
  }
  block {
    label: label(3)
    jmp label(4) 
  }
  block {
    label: label(4)
    phi tmp(1,i1) = imm(0,i1) label(2) imm(1,i1) label(3) 
    stre local(1,i1) tmp(1,i1) 
    jmp label(1) 
  }
  block {
    label: label(1)
    load tmp(2,i1) = local(1,i1) 
    ret tmp(2,i1) 
  }
}
