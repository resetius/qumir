(block
  (use "Клавиатура")
  (fun <main> ()
    (block
      (var к <named сканкод>)
      (var n i64)
      (= к (: 40 <named сканкод>))
      (if
        (== (bitcast (: к <named сканкод>) i64) 40)
        (block
          (block
            (call output_string "вниз")
            (call output_string "\n"))))
      (block
        (call output_bool (!= (bitcast (: к <named сканкод>) i64) 38))
        (call output_symbol (cast 32 char))
        (call output_bool (== (bitcast (: к <named сканкод>) i64) 40))
        (call output_string "\n"))
      (= n (bitcast (: к <named сканкод>) i64))
      (block
        (call output_int64 n 0)
        (call output_string "\n"))
      (= к (: 13 <named сканкод>))
      (block
        (call output_bool (== (bitcast (: к <named сканкод>) i64) 13))
        (call output_string "\n"))
      (cleanup-exit (return)))))