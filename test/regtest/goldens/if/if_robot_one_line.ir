function <main> () { ; ptr to void coroutine result void
  block {
    label: label(0)
    call tmp(0,i1) = справа свободно 
    cmp tmp(0,i1) label(2) label(3) 
  }
  block {
    label: label(2)
    call tmp(1,ptr to void) = вправо 
    await tmp(1,ptr to void) 
    jmp label(4) 
  }
  block {
    label: label(3)
    jmp label(4) 
  }
  block {
    label: label(4)
    call tmp(2,i1) = сверху свободно 
    cmp tmp(2,i1) label(5) label(6) 
  }
  block {
    label: label(5)
    call tmp(3,ptr to void) = вверх 
    await tmp(3,ptr to void) 
    call tmp(4,ptr to void) = закрасить 
    await tmp(4,ptr to void) 
    jmp label(7) 
  }
  block {
    label: label(6)
    jmp label(7) 
  }
  block {
    label: label(7)
    jmp label(1) 
  }
  block {
    label: label(1)
    ret 
  }
}
